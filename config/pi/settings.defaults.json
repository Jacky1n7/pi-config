{
  "defaultProjectTrust": "ask",
  "transport": "auto",
  "terminal": {
    "showTerminalProgress": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "subagents": {
    "defaultThinking": "medium",
    "projectRootResolution": "git-root",
    "agentOverrides": {
      "scout": { "thinking": "low" },
      "worker": { "thinking": "high" },
      "reviewer": { "thinking": "high" },
      "oracle": { "thinking": "max" }
    }
  }
}
